#!/bin/sh

set -eu

marker="${HOME}/.config/lw/theme-applied"
force=0

if [ "${1:-}" = "--force" ]; then
    force=1
fi

if [ "$force" -eq 0 ] && [ -e "$marker" ]; then
    exit 0
fi

mkdir -p "$(dirname "$marker")"

if command -v xdg-user-dirs-update >/dev/null 2>&1; then
    xdg-user-dirs-update >/dev/null 2>&1 || true
fi

set_xfconf() {
    channel="$1"
    prop="$2"
    type="$3"
    value="$4"

    if xfconf-query -c "$channel" -p "$prop" >/dev/null 2>&1; then
        xfconf-query -c "$channel" -p "$prop" -s "$value" >/dev/null 2>&1 || true
    else
        xfconf-query -c "$channel" -p "$prop" -n -t "$type" -s "$value" >/dev/null 2>&1 || true
    fi
}

if command -v xfconf-query >/dev/null 2>&1; then
    set_xfconf xsettings /Net/ThemeName string Arc-Dark
    set_xfconf xsettings /Net/IconThemeName string Papirus-Dark
    set_xfconf xsettings /Gtk/FontName string "Hack 10"
    set_xfconf xsettings /Gtk/MonospaceFontName string "Fira Code 11"
    set_xfconf xfwm4 /general/theme string Arc-Dark
    set_xfconf xfce4-desktop /backdrop/screen0/monitor0/image-path string /usr/share/backgrounds/lw/wallpaper.png
    set_xfconf xfce4-desktop /backdrop/screen0/monitor0/image-style int 5
fi

touch "$marker"
