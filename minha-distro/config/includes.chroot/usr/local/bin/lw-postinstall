#!/bin/sh

set -eu

if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

log() {
    printf '\033[1;32m[+]\033[0m %s\n' "$*"
}

flatpak_apps='
com.valvesoftware.Steam
com.github.tchx84.Flatseal
com.usebottles.bottles
org.localsend.localsend_app
com.discordapp.Discord
md.obsidian.Obsidian
'

apt_tools='
sqlmap
hydra
nikto
dirb
john
hashcat
aircrack-ng
reaver
sleuthkit
binwalk
foremost
dc3dd
yara
apktool
tcpflow
termshark
'

python_deps='
requests
colorama
rich
click
aiohttp
beautifulsoup4
lxml
pyyaml
psutil
'

log "Updating package metadata"
apt-get update

log "Ensuring base post-install dependencies"
apt-get install -y flatpak python3-pip python3-venv

log "Installing extra apt tools"
for pkg in $apt_tools; do
    apt-get install -y "$pkg"
done

if command -v flatpak >/dev/null 2>&1; then
    log "Enabling Flathub"
    flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo || true

    log "Installing Flatpak apps"
    for app in $flatpak_apps; do
        flatpak install -y flathub "$app" || true
    done
fi

log "Creating LW Python environment"
python3 -m venv /opt/lw/python
/opt/lw/python/bin/python -m pip install --upgrade pip
/opt/lw/python/bin/python -m pip install $python_deps
ln -snf /opt/lw/python/bin/python /usr/local/bin/lw-python
ln -snf /opt/lw/python/bin/pip /usr/local/bin/lw-pip

log "LW post-install finished"
cat <<'EOF'

Useful commands:
  lw info
  lw theme --force
  lw autologin status
  lw-python --version

EOF
