#!/bin/sh

set -eu

marker="${HOME}/.config/lw/first-login-done"
[ -e "$marker" ] && exit 0

mkdir -p "$(dirname "$marker")"
/usr/local/bin/lw-ensure-workspace || true
/usr/local/bin/lw-theme-apply --force || true

if command -v notify-send >/dev/null 2>&1; then
    notify-send "LW Hacking OS" "Tema hacker aplicado e sistema pronto para uso." || true
fi

touch "$marker"
