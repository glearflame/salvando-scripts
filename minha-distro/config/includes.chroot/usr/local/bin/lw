#!/bin/sh

set -eu

identity="/usr/share/lw/identity.env"
[ -r "$identity" ] && . "$identity"

: "${LW_NAME:=LW Hacking OS}"
: "${LW_VERSION:=1.0}"
: "${LW_DESCRIPTION:=Debian-based hacker, gaming and power-user system}"

print_banner() {
    if [ -f /usr/share/lw/banner.txt ]; then
        printf '\033[1;32m'
        cat /usr/share/lw/banner.txt
        printf '\033[0m\n'
    else
        printf '%s\n' "$LW_NAME"
    fi
}

print_info_short() {
    system_name="$(uname -sr)"
    desktop_name="${XDG_CURRENT_DESKTOP:-XFCE}"
    printf '%s %s | %s | %s\n' "$LW_NAME" "$LW_VERSION" "$system_name" "$desktop_name"
}

print_info_full() {
    printf 'Name: %s\n' "$LW_NAME"
    printf 'Version: %s\n' "$LW_VERSION"
    printf 'Description: %s\n' "$LW_DESCRIPTION"
    printf 'Kernel: %s\n' "$(uname -srmo)"
    printf 'Hostname: %s\n' "$(hostname 2>/dev/null || printf unknown)"
    printf 'Desktop: %s\n' "${XDG_CURRENT_DESKTOP:-XFCE}"
    printf 'Shell: %s\n' "${SHELL:-/bin/sh}"
}

usage() {
    cat <<'EOF'
Usage: lw [command]

Commands:
  info [--short]     Show distro information
  banner             Print the LW Hacking OS banner
  theme [--force]    Apply the LW hacker theme
  postinstall        Run the LW post-installation setup
  update             Update apt, flatpak and clean the system
  performance ...    Manage performance mode
  hardware ...       Detect hardware and install safe drivers
  dashboard          Open the LW dashboard
  scan-network ...   Scan only the local connected network
  tools              Open the LW toolbox
  autologin ...      Manage LightDM autologin
  help               Show this help
EOF
}

cmd="${1:-info}"
case "$cmd" in
    info)
        shift || true
        if [ "${1:-}" = "--short" ]; then
            print_info_short
        else
            print_banner
            print_info_full
        fi
        ;;
    banner)
        print_banner
        ;;
    theme)
        shift || true
        exec /usr/local/bin/lw-theme-apply "$@"
        ;;
    postinstall)
        shift || true
        exec /usr/local/bin/lw-postinstall "$@"
        ;;
    update)
        shift || true
        exec /usr/local/bin/lw-update "$@"
        ;;
    performance)
        shift || true
        exec /usr/local/bin/lw-performance "$@"
        ;;
    hardware)
        shift || true
        exec /usr/local/bin/lw-hardware-detect "$@"
        ;;
    dashboard)
        shift || true
        exec /usr/local/bin/lw-dashboard "$@"
        ;;
    scan-network)
        shift || true
        exec /usr/local/bin/lw-scan-network "$@"
        ;;
    tools)
        shift || true
        exec /usr/local/bin/lw-tools "$@"
        ;;
    autologin)
        shift || true
        exec /usr/local/bin/lw-autologin "$@"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        printf 'Unknown lw command: %s\n\n' "$cmd" >&2
        usage >&2
        exit 1
        ;;
esac
