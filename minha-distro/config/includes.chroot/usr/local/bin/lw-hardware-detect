#!/bin/sh

set -eu

mode="${1:-status}"

if [ "$(id -u)" -eq 0 ]; then
    log_dir="/var/log/lw"
    state_dir="/var/lib/lw"
else
    log_dir="${HOME}/.local/state/lw"
    state_dir="${HOME}/.local/state/lw"
fi

log_file="${log_dir}/hardware-detect.log"

mkdir -p "$log_dir" "$state_dir"

ts() {
    date '+%Y-%m-%d %H:%M:%S'
}

log() {
    printf '%s %s\n' "$(ts)" "$*" | tee -a "$log_file"
}

install_pkgs() {
    [ "$(id -u)" -eq 0 ] || return 0
    [ -d /run/live ] && return 0
    command -v apt-get >/dev/null 2>&1 || return 0
    export DEBIAN_FRONTEND=noninteractive
    apt-get update >/dev/null 2>&1 || true
    apt-get install -y "$@" >/dev/null 2>&1 || true
}

gpu_line="$(lspci 2>/dev/null | grep -Ei 'VGA|3D|Display' | head -n1 || true)"
wifi_line="$(lspci 2>/dev/null | grep -Ei 'Network controller|Wireless' | head -n1 || true)"
[ -n "$wifi_line" ] || wifi_line="$(lsusb 2>/dev/null | grep -Ei 'Wireless|Wi-Fi|802.11|Realtek|Ralink|Broadcom' | head -n1 || true)"

log "GPU: ${gpu_line:-not detected}"
log "Wi-Fi: ${wifi_line:-not detected}"

case "$gpu_line" in
    *NVIDIA*)
        log "Detected NVIDIA GPU"
        if [ "$mode" = "--auto" ] || [ "$mode" = "--install" ]; then
            install_pkgs nvidia-driver firmware-nvidia-gsp
            log "Attempted installation: nvidia-driver firmware-nvidia-gsp"
        fi
        ;;
    *AMD*|*ATI*)
        log "Detected AMD GPU"
        if [ "$mode" = "--auto" ] || [ "$mode" = "--install" ]; then
            install_pkgs mesa-vulkan-drivers mesa-va-drivers mesa-vdpau-drivers firmware-amd-graphics
        fi
        ;;
    *Intel*)
        log "Detected Intel GPU"
        if [ "$mode" = "--auto" ] || [ "$mode" = "--install" ]; then
            install_pkgs mesa-vulkan-drivers mesa-va-drivers mesa-vdpau-drivers intel-microcode firmware-intel-sound firmware-sof-signed
        fi
        ;;
esac

case "$wifi_line" in
    *Realtek*)
        log "Detected Realtek Wi-Fi"
        [ "$mode" = "--auto" ] || [ "$mode" = "--install" ] && install_pkgs firmware-realtek firmware-realtek-rtl8723cs-bt
        ;;
    *Broadcom*)
        log "Detected Broadcom Wi-Fi"
        [ "$mode" = "--auto" ] || [ "$mode" = "--install" ] && install_pkgs firmware-brcm80211
        ;;
    *Intel*)
        log "Detected Intel Wi-Fi"
        [ "$mode" = "--auto" ] || [ "$mode" = "--install" ] && install_pkgs firmware-iwlwifi
        ;;
    *Atheros*|*Qualcomm*)
        log "Detected Atheros/Qualcomm Wi-Fi"
        [ "$mode" = "--auto" ] || [ "$mode" = "--install" ] && install_pkgs firmware-atheros firmware-ath9k-htc
        ;;
esac

[ "$(id -u)" -eq 0 ] && touch "${state_dir}/hardware-detect.done" || true
log "Hardware detection complete"
